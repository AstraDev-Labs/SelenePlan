      "title": "Audit Chain Status",
      "type": "stat",
      "targets": [{ "expr": "selene_audit_chain_valid", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
